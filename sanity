pipeline:
  projectIdentifier: Quality_Engineering
  orgIdentifier: PROD
  tags:
    Owner: CD
  stages:
    - stage:
        name: Build and Zip automation repo
        identifier: Build_and_Zip_automation_repo
        template:
          templateRef: build_and_Zip_Automation_Repo
          versionLabel: v1
          templateInputs:
            type: CI
            variables:
              - name: skipBuild
                type: String
                value: <+input>.default(false).allowedValues(true,false)
    - stage:
        name: SetUp
        identifier: setup
        type: CI
        spec:
          cloneCodebase: true
          execution:
            steps:
              - step:
                  name: Restore Automation repo
                  identifier: Restore_Automation_repo
                  template:
                    templateRef: Restore_automation_repo
                    versionLabel: v1
              - step:
                  type: Run
                  name: Run Setup
                  identifier: Run_Automation
                  spec:
                    connectorRef: <+variable.garConnectorPath>
                    image: <+variable.garJavaImagePath>
                    shell: Sh
                    command: |-
                      echo "Current shell:"
                      ps -p $$

                      testPriority="<+pipeline.variables.TestsPriority>"
                      baseExclude="COMMUNITY_ONLY,nonSMP"
                      exclusionGroups="$baseExclude"
                      executionSuiteFile=cdpngSetup.xml

                      echo "Current shell:"
                      ps -p $$

                      testPriority="<+pipeline.variables.TestsPriority>"
                      baseExclude="COMMUNITY_ONLY,nonSMP"
                      exclusionGroups="$baseExclude"

                      username="<+pipeline.variables.Username>"
                      password="<+pipeline.variables.Password>"
                      encoded_string=$(printf %s "$username:$password" | iconv -t utf-8 | base64 ) 

                      if [ "$testPriority" = "P0" ]
                        then 
                          exclusionGroups="$baseExclude,P1,P2,P3,P4"
                      fi

                      if [ "$testPriority" = "P1" ]
                        then 
                          exclusionGroups="$baseExclude,P2,P3,P4"
                      fi

                      if [ "$testPriority" = "P1_ONLY" ]
                        then 
                          exclusionGroups="$baseExclude,P0,P2,P3,P4"
                      fi

                      if [ "$testPriority" = "P2" ]
                        then 
                          exclusionGroups="$baseExclude,P3,P4"
                      fi

                      if [ "$testPriority" = "P3" ]
                        then 
                          exclusionGroups="$baseExclude,P4"
                      fi

                      if [ "<+matrix.groups.name>" = "CDPNGSmoke" ] || [ "$testPriority" = "setup" ]
                        then 
                          exclusionGroups="$baseExclude"
                      fi


                      export env_type=<+pipeline.variables.Environment>
                      export project=<+pipeline.variables.Project>
                      export groups=<+matrix.groups.name>
                      export executionSuiteFiles=resources/cdpng/$executionSuiteFile
                      export excludedGroups=$exclusionGroups
                      export skipCDNGTest=false
                      export testCycleKey=<+pipeline.variables.TestCycleKey>
                      export jiraProjectKey=<+pipeline.variables.JiraProjectKey> 
                      export maven_wagon_http_ssl_insecure=true 
                      export maven_wagon_http_ssl_allowall=true
                      export maven_wagon_http_ssl_ignore_validity_dates=true
                      # Set up maven execution based on whether the infra is dynamic or not
                      # mvnCommand=""
                      echo "Exclusion groups: " $exclusionGroups
                      # echo "Maven command to be executed: mvn $mvnCommand"

                      if [ "<+pipeline.variables.Environment>" = "DYNAMIC_SMP" ]
                        then
                          export BASE_AUTH="$encoded_string"
                          export USERNAME=<+pipeline.variables.Username>
                          export BASE_URI=<+pipeline.variables.BaseUri> 
                          cd CDNG 
                          java -jar target/CDNG-1.0-SNAPSHOT-jar-with-dependencies.jar
                        else
                          cd CDNG 
                          java -jar target/CDNG-1.0-SNAPSHOT-jar-with-dependencies.jar
                      fi
                    privileged: false
                    reports:
                      type: JUnit
                      spec:
                        paths:
                          - CDNG/target/test-output/junitreports/*.xml
                    resources:
                      limits:
                        memory: 2000Mi
                        cpu: "0.3"
                  timeout: 4h
                  failureStrategies:
                    - onFailure:
                        errors:
                          - AllErrors
                        action:
                          type: Retry
                          spec:
                            retryCount: 1
                            retryIntervals:
                              - 30s
                            onRetryFailure:
                              action:
                                type: Ignore
                  when:
                    stageStatus: Success
                    condition: <+pipeline.variables.isRerun>!=true
          infrastructure:
            type: KubernetesDirect
            spec:
              connectorRef: cdcie
              namespace: harness-delegate-ng
              automountServiceAccountToken: true
              nodeSelector: {}
              os: Linux
        when:
          pipelineStatus: Success
          condition: <+pipeline.variables.SetUp>==true
        strategy:
          matrix:
            groups:
              - name: setup
        description: ""
    - stage:
        name: SmokeTest
        identifier: SmokeTest_Temp
        template:
          templateRef: CDP_NG_AUTOMATION_EXPERIMENTAL
          versionLabel: SmokeTest_cpu_optimised
          templateInputs:
            type: CI
            when:
              condition: <+pipeline.variables.SmokeTest>==true
            strategy:
              matrix:
                groups:
                  - name: CDPNGSmoke
            variables:
              - name: suitFile
                type: String
                value: cdpngSmokeTest.xml
    - stage:
        name: SmokeNotify
        identifier: SmokeNotify
        description: ""
        type: Approval
        spec:
          execution:
            steps:
              - step:
                  type: ShellScript
                  name: ShellScript_1
                  identifier: ShellScript_1
                  spec:
                    shell: Bash
                    source:
                      type: Inline
                      spec:
                        script: |
                          #!/bin/bash

                          status="<+stage.variables.Status>"
                          triggeredBy="<+pipeline.triggeredBy.name>"
                          environment="<+pipeline.variables.Environment>"
                          sequenceId="<+pipeline.sequenceId>"
                          pipelineExecutionLink="<+pipeline.executionUrl>"
                          slack_webhook_url="<+pipeline.variables.slack_cdp_ng_alert_webhook_url>"

                          # Mention @Ritek using their user ID
                          ritek_user_id="Ritek"

                          if [ "$status" = "FAIL" ]; then
                            message=":x: *CDP NG Smoke Test Failed* :x:\n\n"
                            message+="<@U05K2ABVDHN>, this requires your attention!*\n"
                            message+="*Triggered By:* $triggeredBy\n"
                            message+="*Environment:* CDP NG $environment\n"
                            message+="*Sequence ID:* $sequenceId\n"
                            message+="*Details:* <$pipelineExecutionLink|View Execution Details>\n"
                            icon_emoji=":harnesshd:"
                          else
                            message=":white_check_mark: *CDP NG Smoke Test Passed* :white_check_mark:\n\n"
                            message+="<@U05K2ABVDHN>, great news!*\n"
                            message+="*Triggered By:* $triggeredBy\n"
                            message+="*Environment:* CDP NG $environment\n"
                            message+="*Sequence ID:* $sequenceId\n"
                            message+="*Details:* <$pipelineExecutionLink|View Execution Details>\n"
                            icon_emoji=":harnesshd:"
                          fi

                          json_payload="{\"type\": \"mrkdwn\", \"text\": \"$message\", \"icon_emoji\": \"$icon_emoji\"}"

                          echo "Slack Payload/Message:"
                          echo "$json_payload"

                          curl -X POST --data-urlencode "payload=$json_payload" "$slack_webhook_url"
                    environmentVariables: []
                    outputVariables: []
                    executionTarget: {}
                  timeout: 10m
        tags: {}
        when:
          pipelineStatus: All
          condition: <+pipeline.variables.SmokeNotify>==true
        variables:
          - name: StageName
            type: String
            description: ""
            required: false
            value: Smoke
          - name: Status
            type: String
            description: ""
            required: false
            value: FAIL
