    - stage:
        name: Send Pass Notification
        identifier: Send_Pass_Notification
        description: ""
        type: Custom
        spec:
          execution:
            steps:
              - step:
                  type: ShellScript
                  name: Send Pass Notification
                  identifier: Send_Pass_Notification
                  spec:
                    shell: Bash
                    executionTarget: {}
                    source:
                      type: Inline
                      spec:
                        script: |

                          #!/bin/bash

                          set -o pipefail

                          # --------------------------------------------------
                          # Harness variables
                          # --------------------------------------------------

                          environment="<+pipeline.variables.Environment>"
                          status="<+stage.variables.Status>"
                          pipelineExecutionLink="<+pipeline.executionUrl>"

                          slack_channel="<+pipeline.variables.slack_channel>"

                          echo "Environment: $environment"
                          echo "Status: $status"
                          echo "Slack Channel: $slack_channel"

                          # --------------------------------------------------
                          # Validate Slack channel
                          # --------------------------------------------------

                          if [ -z "$slack_channel" ] || [ "$slack_channel" = "null" ]; then
                              echo "ERROR: Slack channel is empty."
                              exit 1
                          fi

                          slack_channel=$(printf '%s' "$slack_channel" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

                          if [ "${slack_channel#\#}" = "$slack_channel" ]; then
                              slack_channel="#$slack_channel"
                          fi

                          # --------------------------------------------------
                          # Install jq if required
                          # --------------------------------------------------

                          if ! command -v jq >/dev/null 2>&1; then
                              echo "Installing jq..."

                              if command -v microdnf >/dev/null 2>&1; then
                                  microdnf install -y jq
                              elif command -v yum >/dev/null 2>&1; then
                                  yum install -y jq
                              else
                                  echo "ERROR: jq is not installed."
                                  exit 1
                              fi
                          fi

                          # --------------------------------------------------
                          # Determine notification status
                          # --------------------------------------------------

                          case "$(printf '%s' "$status" | tr '[:lower:]' '[:upper:]')" in

                              PASS|SUCCESS)
                                  status_text="*Pipeline Status:* :white_check_mark: *PASSED*"
                                  echo "Preparing PASS notification..."
                                  ;;

                              FAIL|FAILED)
                                  status_text="*Pipeline Status:* :x: *FAILED*"
                                  echo "Preparing FAIL notification..."
                                  ;;

                              *)
                                  echo "ERROR: Unknown stage status: $status"
                                  exit 1
                                  ;;
                          esac

                          # --------------------------------------------------
                          # Prepare Slack message
                          # --------------------------------------------------

                          slack_text=$(printf '%s\n' \
                              "$status_text" \
                              "<${pipelineExecutionLink}|ExecutionLink>" \
                              "" \
                              "*cc:* <@U0ALVSDGK44> <@U0BC7CVMJSD> <@U09NCBKPUDD> <@U038TE720QL> <@U014BFQ9PJS> <@U0422M3S85V>")

                          # --------------------------------------------------
                          # Construct Slack JSON payload
                          # --------------------------------------------------

                          slack_body=$(jq -n \
                              --arg channel "$slack_channel" \
                              --arg text "$slack_text" \
                              '{
                                  channel: $channel,
                                  text: $text,
                                  mrkdwn: true
                              }')

                          if [ -z "$slack_body" ]; then
                              echo "ERROR: Failed to construct Slack payload."
                              exit 1
                          fi

                          # --------------------------------------------------
                          # Send Slack notification through Raven
                          # --------------------------------------------------

                          echo "Sending Slack notification..."

                          slack_resp=$(curl -sS -X POST \
                              'https://slack.com/api/chat.postMessage' \
                              -H 'Authorization: Bearer <+secrets.getValue("e2e_slack_bot_token")>' \
                              -H 'Content-Type: application/json; charset=utf-8' \
                              --data "$slack_body")

                          echo "Slack API response:"
                          echo "$slack_resp"

                          # --------------------------------------------------
                          # Validate Slack response
                          # --------------------------------------------------

                          if ! printf '%s' "$slack_resp" | jq -e '.ok == true' >/dev/null 2>&1; then
                              echo "ERROR: Slack notification failed."
                              echo "$slack_resp"
                              exit 1
                          fi

                          echo "Slack notification sent successfully."
                          echo "Script execution completed."
                    environmentVariables: []
                    outputVariables: []
                  timeout: 10m
